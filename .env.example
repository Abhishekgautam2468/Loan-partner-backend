PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/triopaisa_loan_dms
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=45m
CLIENT_ORIGIN=http://localhost:5173

# SMTP (email) — fill for real sending; leave blank to log-only in dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TrioPaisa <no-reply@triopaisa.com>"

# Cloudinary (document storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=triopaisa/documents

# Uploads
MAX_FILE_MB=10

# Seed admin (used by npm run seed:admin)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@triopaisa.com
SEED_ADMIN_PASSWORD=Admin@12345
